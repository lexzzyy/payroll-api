# Normalise all text files to LF line endings on commit.
# This stops Git warning about CRLF/LF mismatches on Windows.
* text=auto eol=lf

# Source code
*.py text eol=lf
*.pyi text eol=lf

# Configuration
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.json text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Docker & shell
Dockerfile text eol=lf
*.dockerfile text eol=lf
*.sh text eol=lf

# Windows-only files stay as CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.docx binary
*.xlsx binary
*.pptx binary
